<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint" />
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="Octagonal_inspection_chassis" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="Octagonal_inspection_chassis">
    <inertial>
      <origin xyz="-0.00000554286 0.00002933278 -0.01421982468" rpy="0 0 0" />
      <mass value="${Octagonal_inspection_chassis_mass}" />
      <inertia ixx="0.0015275418177565920410156" ixy="-0.0000008571532577619526386"
        ixz="-0.0000002265495691636525989" iyy="0.0016575954131242353515625" iyz="0.0000001203555851159259528"
        izz="0.0029549417436531005859375" />
    </inertial>
    <visual name="Octagonal_inspection_chassis_visual">
      <origin xyz="0 0 -0.047" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix}/Octagonal_inspection_chassis.stl" scale="${scale}" />
      </geometry>
      <material name="default" />
    </visual>
    <collision name="Octagonal_inspection_chassis_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.206 0.2 0.062" />
      </geometry>
    </collision>
  </link>

  <link name="Octagonal_service_cover_with_projecting_roof_edge">
    <inertial>
      <origin xyz="-0.00129910941 -0.00046143565 0.00852465101" rpy="0 0 0" />
      <mass value="${Octagonal_service_cover_with_projecting_roof_edge_mass}" />
      <inertia ixx="0.0007426952700377515869141" ixy="0.000005208195678570148468" ixz="-0.0000019512042894255459309"
        iyy="0.0007931072218634862060547" iyz="-0.0000008478865311748096943" izz="0.0015021906635568205566406" />
    </inertial>
    <visual name="Octagonal_service_cover_with_projecting_roof_edge_visual">
      <origin xyz="0 0 -0.0975" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix}/Octagonal_service_cover_with_projecting_roof_edge.stl"
          scale="${scale}" />
      </geometry>
      <material name="default" />
    </visual>
    <collision name="Octagonal_service_cover_with_projecting_roof_edge_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.208 0.202 0.033" />
      </geometry>
    </collision>
  </link>
  <joint name="Octagonal_service_cover_with_projecting_roof_edge_joint" type="fixed">
    <parent link="Octagonal_inspection_chassis" />
    <child link="Octagonal_service_cover_with_projecting_roof_edge" />
    <origin xyz="0 0 0.0505" rpy="0 0 0" />
  </joint>

  <link name="Octagonal_deck_with_overlapping_drip_skirt">
    <inertial>
      <origin xyz="-0.00200911969 0 -0.00098056889" rpy="0 0 0" />
      <mass value="${Octagonal_deck_with_overlapping_drip_skirt_mass}" />
      <inertia ixx="0.0005690116258245833740234" ixy="0.0000000000000000000029196" ixz="0.0000012917236011896309853"
        iyy="0.0006247117414282354736328" iyz="0.0000000000000000000004923" izz="0.0011923654385640375976563" />
    </inertial>
    <visual name="Octagonal_deck_with_overlapping_drip_skirt_visual">
      <origin xyz="0 0 -0.08" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_prefix}/Octagonal_deck_with_overlapping_drip_skirt.stl" scale="${scale}" />
      </geometry>
      <material name="default" />
    </visual>
    <collision name="Octagonal_deck_with_overlapping_drip_skirt_collision">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.214 0.208 0.018" />
      </geometry>
    </collision>
  </link>
  <joint name="Octagonal_deck_with_overlapping_drip_skirt_joint" type="fixed">
    <parent link="Octagonal_inspection_chassis" />
    <child link="Octagonal_deck_with_overlapping_drip_skirt" />
    <origin xyz="0 0 0.033" rpy="0 0 0" />
  </joint>

</robot>